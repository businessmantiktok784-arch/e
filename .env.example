# Earth Talk environment template.
#
# Copy to `.env` and replace every placeholder. Values here are deliberately
# obvious placeholders: `src/config/env.ts` treats them as "not configured", so a
# copied file can never masquerade as a working deployment.
#
# Server-only secrets must NEVER be given a `VITE_` prefix. Anything prefixed
# with `VITE_` is compiled into the browser bundle.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (Stage 1)
# ---------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=test_whatsapp_access_token_placeholder
WHATSAPP_PHONE_NUMBER_ID=test_whatsapp_phone_number_id_placeholder
WHATSAPP_VERIFY_TOKEN=test_whatsapp_verify_token_placeholder
# Meta app secret used to verify the X-Hub-Signature-256 header on POST events.
WHATSAPP_APP_SECRET=test_whatsapp_app_secret_placeholder
WHATSAPP_GRAPH_API_VERSION=v21.0

# ---------------------------------------------------------------------------
# AI (Stage 2)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=test_gemini_api_key_placeholder
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=30000
MAX_IMAGE_SIZE_BYTES=10000000
AI_RATE_LIMIT_PER_USER=10
AI_RATE_LIMIT_WINDOW_SECONDS=3600

# ---------------------------------------------------------------------------
# Database (Stage 3)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://mock-project-id.supabase.co
# Server-side secret key (Supabase dashboard -> Project Settings -> API).
# This is a privileged credential and must never reach the browser.
SUPABASE_SECRET_KEY=test_supabase_secret_key_placeholder
USER_HASH_SECRET=   # REQUIRED IN PRODUCTION

# ---------------------------------------------------------------------------
# Public API (Stage 4)
# ---------------------------------------------------------------------------
PUBLIC_API_RATE_LIMIT_PER_MINUTE=100
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ENABLE_SECURITY_HEADERS=true

# ---------------------------------------------------------------------------
# Super Admin authentication
# ---------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=owner@earthtalk.local
# Preferred in production: scrypt hash from `npm run admin:hash-password`.
SUPER_ADMIN_PASSWORD_HASH=
# Development convenience only. Ignored in production.
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_SESSION_SECRET=   # REQUIRED IN PRODUCTION
SUPER_ADMIN_SESSION_TTL_SECONDS=43200
SUPER_ADMIN_RATE_LIMIT_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Community (Stage 8)
# ---------------------------------------------------------------------------
ANONYMOUS_CONTRIBUTOR_SECRET=   # REQUIRED IN PRODUCTION
COMMUNITY_RATE_LIMIT_PER_MINUTE=20
COMMUNITY_MAX_TEXT_LENGTH=2000

# ---------------------------------------------------------------------------
# Research (Stage 6)
# ---------------------------------------------------------------------------
RESEARCH_EXPORT_RATE_LIMIT_PER_MINUTE=10
RESEARCH_DATASET_VERSION=RT-RW-RESEARCH-2026-001

# ---------------------------------------------------------------------------
# Validation (Stage 7)
# ---------------------------------------------------------------------------
VALIDATION_MAX_SAMPLES_PER_RUN=50
VALIDATION_MIN_ANSWERED_TOTAL=20
VALIDATION_MIN_PER_CLASS_SUPPORT=5
VALIDATION_MIN_REFERENCE_AGREEMENT_PCT=80
VALIDATION_MAX_EXCLUDED_RATIO_PCT=50

# ---------------------------------------------------------------------------
# Community posts, WhatsApp login and discussion (Stage 12)
# ---------------------------------------------------------------------------
AUTH_SESSION_SECRET=   # REQUIRED IN PRODUCTION
AUTH_SESSION_TTL_SECONDS=604800
AUTH_CODE_TTL_SECONDS=30
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_REQUEST_RATE_LIMIT_PER_MINUTE=5
AUTH_IP_RATE_LIMIT_PER_MINUTE=20
COMMENT_RATE_LIMIT_PER_MINUTE=10
COMMENT_MAX_LENGTH=2000
POST_MEDIA_MAX_STORED_BYTES=1500000
# Labelled demonstration posts. Off by default in production.
DEMO_POSTS_ENABLED=false
