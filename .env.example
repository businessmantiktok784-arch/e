# Rock Talk environment configuration
#
# Reconciled with `src/config/env.ts`. Every variable the server reads is listed
# here with its real default, and production requirements are marked.
#
# In development, unset secrets fall back to clearly-labelled `dev_*` placeholders
# so a fresh clone runs. When NODE_ENV=production the server REFUSES TO START
# without the secrets marked REQUIRED IN PRODUCTION below. It does not silently
# substitute a default, because a predictable signing key would make every
# phone-number hash reversible.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Stage 1 - WhatsApp Cloud API
# ---------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=          # REQUIRED IN PRODUCTION
WHATSAPP_PHONE_NUMBER_ID=       # REQUIRED IN PRODUCTION
WHATSAPP_VERIFY_TOKEN=          # REQUIRED IN PRODUCTION
WHATSAPP_GRAPH_API_VERSION=v21.0

# ---------------------------------------------------------------------------
# Stage 2 - AI analysis
# ---------------------------------------------------------------------------
GEMINI_API_KEY=                 # REQUIRED IN PRODUCTION
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=30000
MAX_IMAGE_SIZE_BYTES=10000000
AI_RATE_LIMIT_PER_USER=10
AI_RATE_LIMIT_WINDOW_SECONDS=3600

# ---------------------------------------------------------------------------
# Stage 3 - Supabase PostgreSQL + PostGIS
# ---------------------------------------------------------------------------
SUPABASE_URL=                   # REQUIRED IN PRODUCTION
SUPABASE_SECRET_KEY=            # REQUIRED IN PRODUCTION
USER_HASH_SECRET=               # REQUIRED IN PRODUCTION

# ---------------------------------------------------------------------------
# Stage 4 - Public API
# ---------------------------------------------------------------------------
PUBLIC_API_RATE_LIMIT_PER_MINUTE=100
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ENABLE_SECURITY_HEADERS=true

# ---------------------------------------------------------------------------
# Stage 5-6 - Super Admin access
#
# There is no expert account system. A single Super Admin signs in with an email
# and a scrypt password hash. SUPER_ADMIN_PASSWORD (plaintext) is accepted ONLY
# when NODE_ENV is not production, as a development convenience; it is stripped
# from the config entirely in production.
# ---------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=owner@rocktalk.local
SUPER_ADMIN_PASSWORD_HASH=      # REQUIRED IN PRODUCTION (scrypt hash)
# SUPER_ADMIN_PASSWORD=          # development only, ignored in production
SUPER_ADMIN_SESSION_SECRET=     # REQUIRED IN PRODUCTION
SUPER_ADMIN_SESSION_TTL_SECONDS=43200
SUPER_ADMIN_RATE_LIMIT_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Stage 8 - Community Discovery
#
# ANONYMOUS_CONTRIBUTOR_SECRET keys the browser contributor token. Web and
# WhatsApp identities are domain-separated ('web:' prefix) so a browser token
# can never collide with a phone number.
# ---------------------------------------------------------------------------
ANONYMOUS_CONTRIBUTOR_SECRET=   # REQUIRED IN PRODUCTION
COMMUNITY_RATE_LIMIT_PER_MINUTE=20
COMMUNITY_MAX_TEXT_LENGTH=2000

# ---------------------------------------------------------------------------
# Stage 6 - Research analytics and export
# ---------------------------------------------------------------------------
RESEARCH_EXPORT_RATE_LIMIT_PER_MINUTE=10
RESEARCH_DATASET_VERSION=RT-RW-RESEARCH-2026-001

# ---------------------------------------------------------------------------
# Stage 7 - Field validation and model evaluation
# ---------------------------------------------------------------------------
VALIDATION_MAX_SAMPLES_PER_RUN=50

# ---------------------------------------------------------------------------
# Stage 12 - Community posts, WhatsApp login and discussion
#
# AUTH_SESSION_SECRET signs web sessions for the WhatsApp verification login.
# A verification code is stored only as a scrypt hash, a session token only as
# a SHA-256 hash, and a phone number only as a one-way HMAC. DEMO_POSTS_ENABLED
# serves the labelled demonstration posts used to exercise the interface; it
# defaults to true in development and false in production.
# ---------------------------------------------------------------------------
AUTH_SESSION_SECRET=           # REQUIRED IN PRODUCTION
AUTH_SESSION_TTL_SECONDS=604800
AUTH_CODE_TTL_SECONDS=30
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_REQUEST_RATE_LIMIT_PER_MINUTE=5
AUTH_IP_RATE_LIMIT_PER_MINUTE=20
COMMENT_RATE_LIMIT_PER_MINUTE=10
COMMENT_MAX_LENGTH=2000
POST_MEDIA_MAX_STORED_BYTES=1500000
DEMO_POSTS_ENABLED=true
# ---------------------------------------------------------------------------
# Frontend (Vite) - read by the browser build, not by the server
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=
VITE_MAP_STYLE_URL=
# My Earth Talk WhatsApp destination, digits only (country code, no symbols).
# When unset the WhatsApp buttons fall back to WhatsApp's generic chat picker.
VITE_WHATSAPP_NUMBER=